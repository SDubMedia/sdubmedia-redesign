<script>
  // Mobile nav. Ten items wrapped onto three rows on a phone, so below 768px
  // the nav collapses behind a hamburger. Desktop behaviour is untouched: the
  // panel is only ever hidden by the media query, so if JS fails the nav still
  // renders as a normal row on desktop.
  (() => {
    const btn = document.querySelector<HTMLButtonElement>('.nav-toggle');
    const nav = document.getElementById('site-nav');
    if (!btn || !nav) return;

    const set = (open: boolean) => {
      nav.dataset.open = String(open);
      btn.setAttribute('aria-expanded', String(open));
    };

    btn.addEventListener('click', () => set(nav.dataset.open !== 'true'));

    // Close after navigating, so returning via the back button is not stuck open.
    nav.addEventListener('click', e => {
      if ((e.target as HTMLElement).closest('a')) set(false);
    });

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && nav.dataset.open === 'true') { set(false); btn.focus(); }
    });

    // Resizing past the breakpoint with the panel open would otherwise leave
    // stale state behind when it collapses back down.
    window.addEventListener('resize', () => {
      if (window.innerWidth > 768) set(false);
    });
  })();

  // Slate click tracking. GA4's automatic outbound-click detection is not
  // dependable for a link to a subdomain of the current site, so fire an
  // explicit event. Mark `slate_click` as a key event in GA to treat it as a
  // conversion. Both the desktop nav link and the mobile one carry the hook.
  document.querySelectorAll('[data-slate-link]').forEach(el => {
    el.addEventListener('click', () => {
      const w = window as unknown as { gtag?: (...a: unknown[]) => void };
      if (typeof w.gtag === 'function') {
        w.gtag('event', 'slate_click', {
          link_url: 'https://slate.sdubmedia.com',
          link_location: el.classList.contains('slate-mobile') ? 'header_mobile' : 'header_nav',
        });
      }
    });
  });
</script>

