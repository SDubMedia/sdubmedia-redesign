---
export interface Props {
  title: string;
  description?: string;
  image?: string;
  jsonLd?: object;
}
const { title, description = "SDub Media: Nashville video production for businesses. Recurring content, corporate video, events, headshots.", image, jsonLd } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  {/* Google Analytics 4. `is:inline` is required: without it Astro bundles and
      defers these, which breaks gtag's expectation of running in the head. The
      measurement ID is public by design (it is visible in page source on every
      GA site), so it is not a secret and does not belong in an env var. */}
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-90E82TVKTC"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-90E82TVKTC');
  </script>

  {/* Favicons generated from public/brand-logo.png (512x512). The apple icon
      is composited on the site background because iOS renders alpha as black. */}
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalURL}>
  <link rel="sitemap" href="/sitemap-index.xml">

  <!-- Open Graph -->
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:type" content="website">
  {/* Must be absolute: Facebook/iMessage/Slack scrapers ignore relative
      og:image URLs, so every share preview was silently imageless. */}
  {image && <meta property="og:image" content={new URL(image, Astro.site).href}>}

  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap');

    :root {
      --bg: #0c1220;
      --bg-elevated: #151d2e;
      --card: #1a2332;
      --text: #e5ebf2;
      --text-dim: #a8b3c7;
      --muted: #7d8ba3;
      --border: rgba(255, 255, 255, 0.10);
      --border-strong: rgba(255, 255, 255, 0.18);
      --brand: #4dc0e8;
      --brand-hover: #6ecff0;
      --amber: #d97706;
      --soft: #111827;
      --radius: 8px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      color: var(--text);
      background: var(--bg);
      line-height: 1.65;
      font-size: 16px;
      font-weight: 400;
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, h4, h5 {
      font-family: 'Space Grotesk', system-ui, sans-serif;
      font-weight: 600;
      line-height: 1.15;
      letter-spacing: -0.02em;
      color: var(--text);
    }

    h1 { font-size: clamp(2.5rem, 5.5vw, 4.25rem); font-weight: 700; }
    h2 { font-size: clamp(1.85rem, 3.5vw, 2.6rem); }
    h3 { font-size: 1.5rem; }

    p { margin-bottom: 1.2rem; color: var(--text-dim); }
    p:last-child { margin-bottom: 0; }
    a { color: var(--brand); text-decoration: none; }
    a:hover { color: var(--brand-hover); }

    .eyebrow {
      font-size: 0.7rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--brand);
      font-weight: 600;
      margin-bottom: 1rem;
      display: block;
    }

    /* Header */
    header.site-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.25rem 2rem;
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(12, 18, 32, 0.92);
      backdrop-filter: blur(12px);
    }

    .logo { display: flex; align-items: center; gap: 0.6rem; color: var(--text); }
    .logo img { height: 28px; }
    .logo-text { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 1.05rem; letter-spacing: -0.02em; }

    /* flex-wrap is required: the nav is wider than a phone viewport, and without
       it the whole page gains a horizontal scrollbar. */
    header nav ul { display: flex; flex-wrap: wrap; gap: 0.25rem; list-style: none; align-items: center; justify-content: flex-end; }
    header nav a { color: var(--text-dim); font-size: 0.875rem; padding: 0.4rem 0.75rem; border-radius: 6px; transition: color 0.15s, background 0.15s; }
    header nav a:hover, header nav a.active { color: var(--text); background: rgba(255,255,255,0.06); }

    /* Layout containers */
    .container { max-width: 1140px; margin: 0 auto; padding: 0 2rem; }
    .container-narrow { max-width: 720px; margin: 0 auto; padding: 0 2rem; }

    section { padding: 5rem 0; }
    section.section-alt { background: var(--soft); }

    /* Scannable lists. The site had ZERO list items in any page body: every
       claim was prose, and most paragraphs ran over 40 words, which is the
       point readers skip a block entirely. */
    .facts { list-style: none; margin: 1.5rem 0 0; display: grid; gap: 0.85rem; }
    .facts li { position: relative; padding-left: 1.6rem; color: var(--text-dim); }
    .facts li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.6em;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--brand);
    }
    .facts li strong { color: var(--text); font-weight: 600; }
    /* A number and a label, for the figures worth seeing before the sentence. */
    .stat-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1.5rem; margin: 2rem 0 0; }
    .stat { border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem; }
    .stat-num { display: block; font-family: 'Space Grotesk', sans-serif; font-size: 1.9rem; font-weight: 700; color: var(--brand); line-height: 1.1; letter-spacing: -0.02em; }
    .stat-label { display: block; font-size: 0.9rem; color: var(--text-dim); margin-top: 0.4rem; }

    .section-head { text-align: center; margin-bottom: 3.5rem; }
    .text-center { text-align: center; }

    /* Buttons */
    .btn {
      display: inline-block;
      padding: 0.75rem 1.75rem;
      border-radius: 8px;
      font-size: 0.9rem;
      font-weight: 600;
      letter-spacing: 0.01em;
      border: 1px solid var(--border-strong);
      color: var(--text);
      transition: all 0.15s;
      background: transparent;
    }
    .btn:hover { border-color: var(--brand); color: var(--brand); background: rgba(77,192,232,0.05); }
    .btn-primary { background: var(--brand); color: #0c1220; border-color: var(--brand); }
    .btn-primary:hover { background: var(--brand-hover); border-color: var(--brand-hover); color: #0c1220; }

    /* Hero — centered, with radial-gradient background and glow */
    .hero {
      min-height: 78vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 6rem 2rem;
      position: relative;
      overflow: hidden;
      background: radial-gradient(ellipse at center top, #1a2540 0%, var(--bg) 70%);
    }
    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image:
        radial-gradient(circle at 20% 30%, rgba(77, 192, 232, 0.08) 0%, transparent 50%),
        radial-gradient(circle at 80% 70%, rgba(77, 192, 232, 0.06) 0%, transparent 50%);
      pointer-events: none;
    }
    .hero .eyebrow { position: relative; }
    .hero h1 { position: relative; max-width: 900px; margin: 1.5rem 0 1.25rem; }
    .accent { color: var(--brand); }
    .hero-subtitle {
      position: relative;
      max-width: 640px;
      margin: 1.75rem auto 0;
      color: var(--text-dim);
      font-size: 1.15rem;
      font-weight: 400;
    }
    .hero-ctas {
      position: relative;
      display: flex;
      gap: 1rem;
      margin-top: 2.5rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    /* Logo strip */
    .logo-strip { display: flex; flex-wrap: wrap; gap: 1.5rem 2.5rem; align-items: center; justify-content: center; margin-top: 1.5rem; }
    .brand { font-family: 'Space Grotesk', sans-serif; font-weight: 600; font-size: 0.95rem; color: var(--muted); letter-spacing: -0.01em; }
    /* Client logos are supplied as WHITE artwork on transparent (dark theme).
       Every logo is the SAME height so the row reads as one system; width just
       follows each logo's aspect (the widest, CBSR, comes to 231px at 62px). */
    .brand-logo-img { height: 62px; width: auto; max-width: 240px; object-fit: contain; opacity: 0.9; }

    /* Weddings page imagery. Frames pulled from real films, so they are always
       16:9 and are shown at their natural ratio rather than cropped. */
    .wedding-hero-img { display: block; width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--border); }
    /* Portrait-orientation strip. Flex rather than grid, and sized by HEIGHT so
       width follows each image's own proportions: nothing is cropped and full
       body portraits stay full body. A grid with 1fr columns blew these up to
       ~545px tall, dwarfing the landscape row above. */
    .photo-strip-tall { display: flex; flex-wrap: wrap; gap: 1.5rem; justify-content: center; }
    .photo-strip-tall img { display: block; height: 340px; width: auto; max-width: 100%; border-radius: 12px; border: 1px solid var(--border); }

    /* auto-fit so the strip works with 3 or 4 images without leaving an orphan */
    .wedding-strip { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; }
    .wedding-strip img { display: block; width: 100%; height: 220px; object-fit: cover; border-radius: 12px; border: 1px solid var(--border); }

    /* Two-door */
    .two-door { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .door { background: var(--card); border-radius: 12px; border: 1px solid var(--border); overflow: hidden; transition: border-color 0.15s; display: block; color: var(--text); }
    .door:hover { border-color: var(--border-strong); color: var(--text); }
    .door-photo-placeholder { background: var(--bg-elevated); height: 220px; display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 0.8rem; }
    .door-photo { display: block; width: 100%; height: 220px; object-fit: cover; }
    .door-content { padding: 1.75rem; }
    .door-content h3 { margin-bottom: 0.75rem; }
    .door-arrow { color: var(--brand); font-size: 0.875rem; font-weight: 600; margin-top: 1.25rem; display: block; }
    /* Tiles are links on the homepage. Only .tile h3/p carry the horizontal
       padding, so the arrow needs its own or it sits flush to the card border.
       margin-top is zeroed because .tile p already supplies the gap. */
    .tile .door-arrow { padding: 0 1.5rem 1.5rem; margin-top: 0; }
    a.tile { transition: border-color 0.15s; }
    a.tile:hover { border-color: var(--border-strong); }
    a.tile:hover .door-arrow { color: var(--brand-hover); }

    /* Tiles */
    .tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
    /* Two-up variant, so a pair of tiles fills the row instead of sitting
       left-aligned against an empty third column. Declared before the 768px
       block below so the single-column mobile rule still wins. */
    .tiles--two { grid-template-columns: repeat(2, 1fr); }
    /* Five-up: three columns leave a trailing pair stranded against an empty
       third column. Flex with a centred wrap puts that pair in the middle.
       The basis matches what a 3-column grid would compute (a third of the
       row, less its share of the 1.5rem gap) so both rows are the same width
       and it still reads as a grid. */
    .tiles--five { display: flex; flex-wrap: wrap; justify-content: center; }
    .tiles--five > .tile { flex: 0 1 calc(33.333% - 16px); min-width: 0; }
    .tile { background: var(--card); border-radius: 12px; border: 1px solid var(--border); overflow: hidden; }
    .tile-image { display: block; width: 100%; height: 180px; object-fit: cover; background: var(--bg-elevated); }
    /* Two-up tiles are twice as wide, so a fixed 180px crops portraits down to
       a letterbox. Proportional height shows most of the frame at any width. */
    .tiles--two .tile-image { height: auto; aspect-ratio: 16 / 10; }
    .tile h3, .tile p { padding: 0 1.5rem; }
    .tile h3 { padding-top: 1.5rem; padding-bottom: 0.5rem; }
    .tile p { padding-bottom: 1.5rem; }

    /* Footer */
    footer.site-footer {
      border-top: 1px solid var(--border);
      padding: 3.5rem 2rem 2rem;
      background: var(--soft);
    }
    .footer-grid {
      max-width: 1140px; margin: 0 auto;
      display: flex; justify-content: space-between; align-items: flex-start;
      gap: 2.5rem; flex-wrap: wrap;
    }
    .footer-brand { display: flex; flex-direction: column; gap: 0.85rem; align-items: flex-start; max-width: 260px; }
    .footer-tag { font-size: 0.85rem; color: var(--muted); margin: 0; line-height: 1.55; }
    /* Content-width columns, even rhythm between them. padding-top drops the
       headers to the logo's text baseline so the four tops read as one line. */
    .footer-cols { display: flex; gap: clamp(2.5rem, 6vw, 5.5rem); flex-wrap: wrap; }
    .footer-col { padding-top: 0.4rem; }
    .footer-social { display: flex; gap: 0.9rem; margin-top: 0.2rem; }
    .footer-social a { color: var(--muted); display: inline-flex; padding: 0.2rem; }
    .footer-social a:hover { color: var(--text); }
    .footer-contact { display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.9rem; }
    .footer-contact a { color: var(--text-dim); }
    .footer-contact a:hover { color: var(--text); }
    .footer-h {
      font-size: 0.7rem; letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--muted); font-weight: 600; margin-bottom: 1rem;
    }
    .footer-col { display: flex; flex-direction: column; align-items: flex-start; }
    .footer-col a { color: var(--text-dim); font-size: 0.9rem; padding: 0.28rem 0; }
    .footer-col a:hover { color: var(--text); }
    .footer-bottom {
      max-width: 1140px; margin: 2.75rem auto 0; padding-top: 1.5rem;
      border-top: 1px solid var(--border);
      display: flex; justify-content: space-between; align-items: center;
      flex-wrap: wrap; gap: 0.5rem 1.5rem;
    }
    .copyright { font-size: 0.8rem; color: var(--muted); }

    /* Blog */
    .blog-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.5rem; margin-top: 2rem; }
    .blog-card { background: var(--card); border-radius: 12px; border: 1px solid var(--border); overflow: hidden; transition: border-color 0.15s; display: block; color: var(--text); }
    .blog-card:hover { border-color: var(--border-strong); color: var(--text); }
    .blog-card-image { background: var(--bg-elevated); height: 200px; overflow: hidden; }
    .blog-card-image img { width: 100%; height: 100%; object-fit: cover; }
    .blog-card-content { padding: 1.5rem; }
    .blog-card-content h3 { font-size: 1.15rem; margin-bottom: 0.6rem; }
    .blog-card-content p { font-size: 0.875rem; margin-bottom: 0; }
    .blog-card-meta { font-size: 0.75rem; color: var(--muted); margin-bottom: 0.75rem; }

    /* Blog post: three clear tiers, big main head, distinct subheads, comfortable body */
    .blog-post { max-width: 740px; margin: 0 auto; padding: 4rem 2rem; }
    .blog-post h1 { font-size: clamp(2.6rem, 6vw, 4.5rem); line-height: 1.06; margin-bottom: 1.25rem; text-align: center; }
    .blog-post-meta { color: var(--muted); font-size: 0.85rem; margin-bottom: 3rem; padding-bottom: 2rem; border-bottom: 1px solid var(--border); text-align: center; }

    /* Body text: larger, easy to read */
    .blog-post-body { font-size: 1.15rem; line-height: 1.78; }
    .blog-post-body p { margin-bottom: 1.5rem; }

    /* In-text links: classic royal blue + underline so they're obvious within prose */
    .blog-post-body a { color: #4f7cff; text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
    .blog-post-body a:hover { color: #7da2ff; }

    /* Subheadings: snappier, bold, tight tracking, clearly below the main head */
    .blog-post-body h2 { font-size: clamp(1.9rem, 3.2vw, 2.45rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1.15; margin: 3rem 0 1rem; }
    .blog-post-body h3 { font-size: 1.45rem; font-weight: 600; letter-spacing: -0.02em; color: var(--brand); margin: 2.25rem 0 0.6rem; }

    .blog-post-body ul, .blog-post-body ol { margin: 0 0 1.5rem 1.5rem; color: var(--text-dim); }
    .blog-post-body li { margin-bottom: 0.5rem; }
    .blog-post-body strong { color: var(--text); }
    .blog-post-body img { max-width: 100%; border-radius: 8px; margin: 2rem 0; }
    .blog-post-body blockquote { border-left: 3px solid var(--brand); padding-left: 1.25rem; margin: 2rem 0; color: var(--text-dim); font-style: italic; }

    /* Pillar/cluster series links */
    .series-link { font-size: 0.9rem; color: var(--text-dim); background: var(--card); border: 1px solid var(--border); border-radius: 8px; padding: 0.8rem 1.1rem; margin-bottom: 2.5rem; text-align: center; }
    .series-link a { font-weight: 600; }
    .series-children { margin-top: 3.5rem; padding: 1.75rem 2rem; background: var(--card); border: 1px solid var(--border); border-radius: 12px; }
    .series-children h3 { color: var(--brand); font-size: 1.2rem; margin-bottom: 1rem; }
    .series-children ul { list-style: none; margin: 0; padding: 0; }
    .series-children li { margin-bottom: 0.6rem; padding-left: 1.1rem; position: relative; }
    .series-children li::before { content: '→'; position: absolute; left: 0; color: var(--brand); }
    .series-children li a { font-weight: 500; color: var(--text); }
    .series-children li a:hover { color: var(--brand); }

    /* Blog post CTA */
    .blog-post-cta { margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--border); text-align: center; }
    .blog-post-cta p { color: var(--text-dim); margin-bottom: 1.5rem; }

    /* Responsive */
    /* Mobile-only Slate link, sits left of the hamburger. margin-left:auto
       pushes it and the button together to the right edge. */
    .slate-mobile { display: none; color: var(--brand); font-size: 0.875rem; font-weight: 600; white-space: nowrap; }
    .slate-mobile:hover { color: var(--brand-hover); }

    /* Hamburger. Hidden on desktop; the media query below turns it on. */
    .nav-toggle {
      display: none;
      width: 44px;
      height: 44px;
      align-items: center;
      justify-content: center;
      background: transparent;
      border: 1px solid var(--border-strong);
      border-radius: 8px;
      cursor: pointer;
      padding: 0;
    }
    .nav-toggle-bars, .nav-toggle-bars::before, .nav-toggle-bars::after {
      display: block;
      width: 18px;
      height: 2px;
      background: var(--text);
      border-radius: 2px;
      transition: transform 0.18s, opacity 0.18s;
    }
    .nav-toggle-bars::before, .nav-toggle-bars::after { content: ''; position: absolute; }
    .nav-toggle-bars::before { transform: translateY(-6px); }
    .nav-toggle-bars::after { transform: translateY(6px); }
    /* Bars morph into an X when the panel is open. */
    .nav-toggle[aria-expanded="true"] .nav-toggle-bars { background: transparent; }
    .nav-toggle[aria-expanded="true"] .nav-toggle-bars::before { transform: rotate(45deg); }
    .nav-toggle[aria-expanded="true"] .nav-toggle-bars::after { transform: rotate(-45deg); }

    @media (max-width: 768px) {
      .two-door { grid-template-columns: 1fr; }
      .tiles { grid-template-columns: 1fr; }
      /* .tiles--five is flex, so the grid rule above does not reach it. */
      .tiles--five > .tile { flex-basis: 100%; }
      .wedding-strip { grid-template-columns: 1fr; }
      .photo-strip-tall img { height: 260px; }
      .nav-toggle { display: flex; }
      .slate-mobile { display: inline-block; margin-left: auto; margin-right: 0.85rem; }
      .nav-slate { display: none; }   /* shown beside the button instead */

      /* Footer: brand goes full width, the two link columns share a row.
         Everything stays left-aligned; centred stacks read as filler. */
      footer.site-footer { padding: 2.75rem 1.5rem 1.75rem; }
      .footer-grid { gap: 2rem; }
      .footer-brand { max-width: none; }
      .footer-cols { width: 100%; gap: 2rem 3rem; }
      .footer-col { padding-top: 0; }
      .footer-col a { padding: 0.4rem 0; }
      /* The nav becomes a panel under the sticky header. Ten items wrapped onto
         three rows before this, which pushed the page content down the screen. */
      header nav {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: rgba(12, 18, 32, 0.98);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
        max-height: calc(100vh - 100%);
        overflow-y: auto;
      }
      header nav[data-open="true"] { display: block; }
      header nav ul { flex-direction: column; align-items: stretch; gap: 0; padding: 0.5rem 0; }
      header nav a { display: block; font-size: 0.95rem; padding: 0.75rem 2rem; border-radius: 0; }
    }
  </style>
</head>
<body>

<header class="site-header">
  <a href="/" class="logo">
    <img src="/brand-logo.png" alt="SDub Media">
    <span class="logo-text">SDub Media</span>
  </a>
  {/* Mobile-only twin of the Slate link in the nav below. Slate is the one
      destination that should stay one tap away rather than hiding behind the
      hamburger, so on phones it sits beside the button and the copy inside the
      panel is hidden. Keep the two hrefs in sync. */}
  <a href="https://slate.sdubmedia.com" target="_blank" rel="noopener" class="slate-mobile" data-slate-link>Slate ↗</a>
  <button class="nav-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
    <span class="nav-toggle-bars" aria-hidden="true"></span>
  </button>
  <nav id="site-nav">
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/business">Business</a></li>
      <li><a href="/dance">Dance</a></li>
      <li><a href="/corporate-events">Events</a></li>
      <li><a href="/photography">Photography</a></li>
      <li><a href="/weddings">Weddings</a></li>
