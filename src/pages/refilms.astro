---
import Layout from '../layouts/Layout.astro';
import Video from '../components/Video.astro';
import { VIDEO_BASE } from '../lib/video-manifest.mjs';

// HIDDEN pitch page, same rules as /lifestyle (Geoff, 2026-08-22): send-the-
// link only. Not linked from nav, footer, or any page; noindex + excluded
// from the sitemap (astro.config.mjs filter) + X-Robots-Tag in vercel.json.
// Do NOT add links to it or remove noindex.
//
// Real-estate film samples, self-hosted on R2 via scripts/encode-upload.mjs
// and the src/data/videos.json manifest — same pipeline as every other video
// on the site. Copy stays minimal on purpose — this page is for WATCHING.

// One wide film gets the feature slot; the vertical (phone-format) films sit
// three-up beneath it so the page reads as two balanced rows instead of a
// lopsided single column of mixed widths.
const FEATURE = { id: 'david-holloway', title: 'David Holloway', line: 'Agent-led home tour' };
const FILMS = [
  { id: 'general-forrest-ct', title: '5332 General Forrest Ct · Nashville', line: 'Listing film' },
  // Social clip pulled for now (Geoff, 2026-08-22) — still on R2 and in the
  // manifest; restore by re-adding:
  // { id: 'general-forrest-ct-clip', title: '5332 General Forrest Ct', line: 'Social clip' },
  { id: 'firefly-acres', title: 'Firefly Acres', line: 'Property film' },
];
// Cover = the walkthrough's exterior title-card frame, straight from R2 (no
// local copy — the repo is public and holds no client media). Pinned to this
// key on purpose: the video tiles use Geoff's chosen poster frames (p3), but
// the sharp address-card exterior is the better full-viewport cover.
const cover = { poster: `${VIDEO_BASE}/general-forrest-ct-p2.jpg` };
---
<Layout
  title="SDub Media Real Estate Films"
  description="Listing and property films by SDub Media, Nashville."
  noindex
>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&display=swap" rel="stylesheet">

<section class="rf-cover">
  {cover && <img src={cover.poster} alt="Exterior of 5332 General Forrest Ct with its address title card" fetchpriority="high" />}
  <div class="rf-cover-overlay"></div>
  <div class="rf-cover-text">
    <h1>SDub Media</h1>
    <p>Real estate films · Nashville</p>
  </div>
</section>

<section class="rf-intro">
  <p>Listing and property films, shot and edited in Nashville. Vertical, made for the places buyers actually scroll.</p>
</section>

<section class="rf-films">
  <div class="rf-feature">
    <Video id={FEATURE.id} title={FEATURE.title} />
    <p class="rf-film-caption">{FEATURE.title} <span>· {FEATURE.line}</span></p>
  </div>
  <div class="rf-row">
    {FILMS.map(f => (
      <div class="rf-film">
        <Video id={f.id} title={f.title} />
        <p class="rf-film-caption">{f.title} <span>· {f.line}</span></p>
      </div>
    ))}
  </div>
</section>

<section class="rf-close-cta">
  <p>Like what you see?</p>
  <a href="/contact/" class="btn btn-primary">Start a conversation</a>
</section>

<style>
  /* Same Slate-gallery-style cover as /lifestyle. */
  .rf-cover { position: relative; height: calc(100svh - 72px); min-height: 420px; overflow: hidden; background: #0f172a; }
  .rf-cover img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; }
  .rf-cover-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.45) 100%); }
  .rf-cover-text { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; text-align: center; padding: 1rem 1rem 9svh; }
  .rf-cover-text h1 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 400;
    font-size: clamp(3rem, 8vw, 6rem);
    letter-spacing: 0.02em;
    line-height: 1.05;
    color: #fff;
  }
  .rf-cover-text p { color: rgba(255,255,255,0.85); letter-spacing: 0.14em; text-transform: uppercase; font-size: 0.8rem; margin-top: 0.75rem; }

  .rf-intro { background: #fff; text-align: center; padding: 3.5rem 1.5rem 1rem; }
  .rf-intro p {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.5rem;
    color: #0f172a;
    max-width: 34rem;
    margin: 0 auto;
  }

  /* One wide feature, then the vertical films three-up on desktop (stacked on
     phones). The Video component centers each portrait player in its cell. */
  .rf-films { background: #fff; padding: 2.5rem 1rem 1.5rem; max-width: 62rem; margin: 0 auto; }
  .rf-feature { max-width: 52rem; margin: 0 auto 3rem; }
  .rf-row { display: grid; grid-template-columns: 1fr; gap: 2.5rem; }
  @media (min-width: 720px) { .rf-row { grid-template-columns: repeat(2, 1fr); gap: 1.5rem; align-items: start; max-width: 44rem; margin-inline: auto; } }
  .rf-row .rf-film { min-width: 0; }
  .rf-film-caption {
    text-align: center;
    margin-top: 0.9rem;
    font-size: 0.95rem;
    color: #0f172a;
  }
  .rf-film-caption span { color: #64748b; }

  .rf-close-cta { background: #fff; text-align: center; padding: 2rem 1.5rem 4.5rem; }
  .rf-close-cta p {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.6rem;
    color: #0f172a;
    margin-bottom: 1.5rem;
  }
</style>
</Layout>
