---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { imageDims, thumbPath } from '../../lib/image-size.mjs';

// Cards render ~200px tall; the full photos cost 5.7MB on this one page.
// thumbPath swaps in the 560px variants from scripts/gen-blog-thumbs.py
// (falling back to the full image if a thumb is missing), and real dims stop
// the grid from shifting as they load.
const card = (img) => {
  const src = thumbPath(img);
  return { src, ...(imageDims(src) || {}) };
};

// This page has been through two passes. Keep both reasons in mind before
// changing it again.
//
// PASS 1 (2026-07-31) fixed a credibility problem: it was a flat
// reverse-chronological grid of all 20 posts with the publish date leading
// every card, and because ten posts share a pubDate it read as a column of
// near-identical keyword titles all stamped the same day. That is the
// signature of bulk generated SEO content, on a site whose whole point is that
// it is not that.
//
// PASS 2 (2026-08-01) undid the collateral damage. Pass 1 replaced the card
// grid with one wide "lead" card per topic plus plain text lists, which meant
// 15 of 20 posts lost their image and the page lost the tidy columns-and-rows
// look Geoff liked. He flagged it immediately and he was right: the date
// problem never required giving up the cards.
//
// Current design keeps BOTH: the original .blog-grid / .blog-card markup and
// styling (shared, in Layout.astro) inside per-topic sections. So it still
// reads as topics rather than one undifferentiated keyword stream, and it
// still leads with no dates, but it looks like the card grid it always was.
//
// Constraints that must survive any future edit:
//   - No pubDate, slug, filename or title may change. Rewriting dates on
//     published posts discards ranking history the same way changing a URL
//     does. Dates still ship in each post's byline and BlogPosting JSON-LD,
//     so Google sees exactly what it always saw. Only the INDEX omits them.
//   - Every post must remain reachable from this page. The `rest` group below
//     exists so an unmapped cluster can never silently drop posts.

const posts = await getCollection('blog', ({ data }) => !data.draft);

// Display labels and running order, keyed on the `cluster` frontmatter that
// already drives the pillar/cluster interlinking. No second taxonomy.
const TOPICS = [
  { cluster: 'video-production',  label: 'Hiring a production company', blurb: 'What the work costs, what to ask for, and how to compare quotes that are not really comparable.' },
  { cluster: 'corporate-video',   label: 'Corporate and brand video',   blurb: 'Testimonials, event coverage, and what a corporate shoot actually involves.' },
  { cluster: 'real-estate-photo', label: 'Real estate photography',     blurb: 'Gear, lighting, editing limits, and shooting listings well enough to sell them.' },
  { cluster: 'real-estate',       label: 'Real estate video',           blurb: 'Listing video and what agents should expect from it.' },
  { cluster: 'videographer',      label: 'Working with a videographer', blurb: 'Finding one, briefing one, and knowing whether you got what you paid for.' },
];

const byCluster = (c: string) =>
  posts
    .filter(p => p.data.cluster === c)
    // Pillar first, then newest. Within a topic the pillar is the entry point.
    .sort((a, b) =>
      (b.data.isPillar ? 1 : 0) - (a.data.isPillar ? 1 : 0) ||
      b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
    );

const groups = TOPICS
  .map(t => ({ ...t, items: byCluster(t.cluster) }))
  .filter(g => g.items.length > 0);

// Anything whose cluster is missing or unmapped. Normally empty.
const mapped = new Set(TOPICS.map(t => t.cluster));
const rest = posts
  .filter(p => !p.data.cluster || !mapped.has(p.data.cluster))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Blog | SDub Media Nashville Video Production"
  description="Practical guides on video production for Nashville businesses. Corporate video, brand video, events, and more."
>

<section>
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">From the field</span>
      <h1>The Nashville Video Production Blog</h1>
      <p style="max-width: 600px; margin: 1rem auto 0;">Practical guides for Nashville businesses thinking about video. No fluff, no sales pitch. Just what we've learned shooting in this market.</p>
    </div>

    {posts.length === 0 ? (
      <p style="color: var(--muted);">First posts coming soon. Check back Monday.</p>
    ) : (
      <div class="topics">
        {groups.map(g => (
          <div class="topic">
            <div class="topic-head">
              <h2>{g.label}</h2>
              <p>{g.blurb}</p>
            </div>
            <div class="blog-grid">
              {g.items.map(post => (
                <a href={`/blog/${post.id}/`} class="blog-card">
                  {post.data.image && (
                    <div class="blog-card-image">
                      <img {...card(post.data.image)} alt={post.data.title} loading="lazy" />
                    </div>
                  )}
                  <div class="blog-card-content">
                    {post.data.isPillar && <div class="blog-card-meta start-here">Start here</div>}
                    <h3>{post.data.title}</h3>
                    <p>{post.data.description}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))}

        {rest.length > 0 && (
          <div class="topic">
            <div class="topic-head"><h2>More</h2></div>
            <div class="blog-grid">
              {rest.map(post => (
                <a href={`/blog/${post.id}/`} class="blog-card">
                  {post.data.image && (
                    <div class="blog-card-image">
                      <img {...card(post.data.image)} alt={post.data.title} loading="lazy" />
                    </div>
                  )}
                  <div class="blog-card-content">
                    <h3>{post.data.title}</h3>
                    <p>{post.data.description}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    )}
  </div>
</section>

<style>
  /* Only the topic scaffolding lives here. The cards themselves deliberately
     reuse .blog-grid / .blog-card from Layout.astro so this page cannot drift
     away from how post cards look everywhere else. */
  .topics { display: grid; gap: 3.5rem; }
  .topic { min-width: 0; }
  .topic-head { margin-bottom: 0.5rem; }
  .topic-head h2 { margin: 0 0 0.4rem; font-size: 1.4rem; }
  .topic-head p { margin: 0; color: var(--muted); max-width: 620px; font-size: 0.95rem; }
  /* .blog-card-meta is where the publish date used to sit. Same slot, same
     styling, now carrying the one label that helps a reader choose. */
  .start-here { color: var(--brand); letter-spacing: 0.06em; text-transform: uppercase; }
  @media (max-width: 768px) { .topics { gap: 2.5rem; } }
</style>

</Layout>
