---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// REBUILT 2026-07-31. This page was a flat reverse-chronological grid of every
// post, each card led by its publish date. Because ten posts share a pubDate,
// the index rendered as a column of near-identical keyword titles all stamped
// the same day, which is the most recognisable signature of bulk AI SEO
// content. It was the last page on the site still reading that way.
//
// The fix is presentational only. NOTHING about the posts changed:
//   - no pubDate was touched (rewriting dates on published posts throws away
//     ranking history, the same way changing a slug does)
//   - no slug, filename or title was touched
//   - dates still ship in each post's byline and in its BlogPosting JSON-LD,
//     so Google sees exactly what it saw before
// The index simply stops leading with the date, and groups by topic instead,
// which is also how a human browses: by what they want to know.
//
// Grouping reuses the existing `cluster` frontmatter that already drives the
// pillar/cluster interlinking, so there is no second taxonomy to maintain.

const posts = await getCollection('blog', ({ data }) => !data.draft);

// Display labels and running order. A cluster missing from this map still
// renders (see `rest` below) rather than vanishing, so adding a new cluster can
// never silently drop posts off the index.
const TOPICS = [
  { cluster: 'video-production',  label: 'Hiring a production company', blurb: 'What the work costs, what to ask for, and how to compare quotes that are not really comparable.' },
  { cluster: 'corporate-video',   label: 'Corporate and brand video',   blurb: 'Testimonials, event coverage, and what a corporate shoot actually involves.' },
  { cluster: 'real-estate-photo', label: 'Real estate photography',     blurb: 'Gear, lighting, editing limits, and shooting listings well enough to sell them.' },
  { cluster: 'real-estate',       label: 'Real estate video',           blurb: 'Listing video and what agents should expect from it.' },
  { cluster: 'videographer',      label: 'Working with a videographer', blurb: 'Finding one, briefing one, and knowing whether you got what you paid for.' },
];

const byCluster = (c: string) =>
  posts
    .filter(p => p.data.cluster === c)
    // Pillar first, then newest. Within a topic the pillar is the entry point.
    .sort((a, b) =>
      (b.data.isPillar ? 1 : 0) - (a.data.isPillar ? 1 : 0) ||
      b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
    );

const groups = TOPICS
  .map(t => ({ ...t, items: byCluster(t.cluster) }))
  .filter(g => g.items.length > 0);

// Anything whose cluster is missing or unmapped. Normally empty.
const mapped = new Set(TOPICS.map(t => t.cluster));
const rest = posts
  .filter(p => !p.data.cluster || !mapped.has(p.data.cluster))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Blog | SDub Media Nashville Video Production"
  description="Practical guides on video production for Nashville businesses. Corporate video, brand video, events, and more."
>

<section>
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">From the field</span>
      <h1>The Nashville Video Production Blog</h1>
      <p style="max-width: 600px; margin: 1rem auto 0;">Practical guides for Nashville businesses thinking about video. No fluff, no sales pitch. Just what we've learned shooting in this market.</p>
    </div>

    {posts.length === 0 ? (
      <p style="color: var(--muted);">First posts coming soon. Check back Monday.</p>
    ) : (
      <div class="topics">
        {groups.map(g => (
          <div class="topic">
            <div class="topic-head">
              <h2>{g.label}</h2>
              <p>{g.blurb}</p>
            </div>
            <a href={`/blog/${g.items[0].id}`} class="lead-post">
              {g.items[0].data.image && (
                <div class="lead-post-image">
                  <img src={g.items[0].data.image} alt={g.items[0].data.title} loading="lazy" />
                </div>
              )}
              <div class="lead-post-body">
                <span class="lead-tag">Start here</span>
                <h3>{g.items[0].data.title}</h3>
                <p>{g.items[0].data.description}</p>
              </div>
            </a>
            {g.items.length > 1 && (
              <ul class="more-posts">
                {g.items.slice(1).map(post => (
                  <li>
                    <a href={`/blog/${post.id}`}>
                      <span class="more-title">{post.data.title}</span>
                      <span class="more-desc">{post.data.description}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}

        {rest.length > 0 && (
          <div class="topic">
            <div class="topic-head"><h2>More</h2></div>
            <ul class="more-posts">
              {rest.map(post => (
                <li>
                  <a href={`/blog/${post.id}`}>
                    <span class="more-title">{post.data.title}</span>
                    <span class="more-desc">{post.data.description}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .topics { display: grid; gap: 4rem; margin-top: 1rem; }
  .topic { min-width: 0; }
  .topic-head { margin-bottom: 1.5rem; }
  .topic-head h2 { margin: 0 0 0.4rem; font-size: 1.5rem; }
  .topic-head p { margin: 0; color: var(--muted); max-width: 620px; }

  .lead-post {
    display: grid; grid-template-columns: 300px 1fr; gap: 1.75rem;
    align-items: center; text-decoration: none; color: inherit;
    background: var(--card); border: 1px solid var(--border);
    border-radius: 14px; overflow: hidden; transition: border-color 0.2s;
  }
  .lead-post:hover { border-color: var(--brand); }
  .lead-post-image { height: 100%; min-height: 190px; }
  .lead-post-image img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .lead-post-body { padding: 1.5rem 1.75rem 1.5rem 0; min-width: 0; }
  .lead-tag {
    display: inline-block; font-size: 0.7rem; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--brand); margin-bottom: 0.6rem;
  }
  .lead-post-body h3 { margin: 0 0 0.5rem; font-size: 1.2rem; line-height: 1.35; }
  .lead-post-body p { margin: 0; color: var(--muted); font-size: 0.95rem; }

  .more-posts { list-style: none; padding: 0; margin: 1.25rem 0 0; }
  .more-posts li { border-top: 1px solid var(--border); }
  .more-posts a {
    display: block; padding: 1rem 0.25rem; text-decoration: none;
    color: inherit; transition: padding-left 0.15s, color 0.15s;
  }
  .more-posts a:hover { padding-left: 0.75rem; color: var(--brand); }
  .more-title { display: block; font-weight: 600; margin-bottom: 0.2rem; }
  .more-desc { display: block; color: var(--muted); font-size: 0.9rem; line-height: 1.5; }

  /* Single column well before the grid actually crushes, so the lead card's
     image never squeezes to a sliver on tablets. */
  @media (max-width: 720px) {
    .lead-post { grid-template-columns: 1fr; }
    .lead-post-image { min-height: 180px; max-height: 220px; }
    .lead-post-body { padding: 1.25rem 1.25rem 1.5rem; }
    .topics { gap: 3rem; }
  }
</style>

</Layout>
