---
import Layout from '../layouts/Layout.astro';

// PRICING is real, confirmed by Geoff 2026-07-31. Keep it accurate or remove
// it; a stale price is worse than no price.
//   Photos, per listing ................. $200
//   Video, per listing .................. $200
//   Drone, added to a photo/video shoot .. $50
//   Drone only .......................... $200
//
// TWILIGHT: removed as a tile, because Geoff has no twilight frames to show and
// illustrating that claim with a daylight exterior would undercut it. Bring it
// back as a tile (or an add-on line in the pricing table) once a twilight shot
// exists. The blog post on twilight real estate photography still links here.
//
// WHY THIS PAGE EXISTS: six of the twenty blog posts target real estate
// photography keywords (best camera, best lens, iPhone, editing, tips,
// twilight) and there was nowhere on the site to hire us for it. Those posts
// are pure how-to and never mention SDub, so they attract DIY agents with no
// path to becoming clients. This page is that path, and those posts should
// link here.
//
// TEAM FACTS, confirmed 2026-07-31: five people. One photographer shoots homes
// and nothing else (the differentiator this page leads on), one covers live
// events, two are videographers including Geoff, and Geoff shoots every service
// the business offers.
//
// TURNAROUND is 48 hours for photos and video, confirmed by Geoff 2026-07-31.
// An earlier "next-day delivery" line was invented and removed; do not state
// any figure other than the confirmed one.
// ────────────────────────────────────────────────────────────────────
---
<Layout
  title="Real Estate Photography Nashville | SDub Media"
  description="Listing photography for Nashville-area agents. Photos and video in 48 hours, a photographer who shoots homes and nothing else, aerials for $50. $200 per listing."
>
<section>
  <div class="container-narrow text-center">
    <span class="eyebrow">For real estate agents</span>
    <h1>Listing photos that go up<br>while the listing is still news.</h1>
    <p style="font-size: 1.1rem; margin-top: 1.5rem;">One photographer on our team shoots real estate and nothing else. The editing happens in house, so your gallery is back in 48 hours. Priced per listing, so you know the number before you book.</p>
    <div style="margin-top: 2.5rem;">
      <a href="/contact" class="btn btn-primary">Book a listing</a>
    </div>
  </div>
  <div class="container" style="margin-top: 3.5rem;">
    <img class="wedding-hero-img" src="/images/real-estate/exterior-front.jpg"
         alt="The front elevation of a stone home in Nashville, shot in clear daylight"
         width="1600" height="1069" />
  </div>
</section>

<section style="background: var(--soft);">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">What you get</span>
      <h2>A full gallery, not a handful of hero shots.</h2>
    </div>
    <div class="tiles">
      <div class="tile">
        <img class="tile-image" src="/images/real-estate/living-room.jpg" alt="A living room with the windows correctly exposed rather than blown out" loading="lazy" width="1600" height="1069" />
        <h3>Every Room, Properly Lit</h3>
        <p>Interiors shot and blended so the windows are not blown out and the rooms are not orange. That sounds basic. Look at any listing feed and count how many get it right.</p>
      </div>
      <div class="tile">
        <img class="tile-image" src="/images/real-estate/aerial-neighborhood.jpg" alt="Aerial view over a golf course neighbourhood of large homes" loading="lazy" width="1600" height="1069" />
        <h3>Aerials That Show the Lot</h3>
        <p>Ground level cannot tell a buyer the yard backs onto a fairway, or how much land comes with the house. An aerial answers in one frame what three paragraphs of listing copy tries to. It is also the shot an agent with a phone cannot take.</p>
      </div>
      <div class="tile">
        <img class="tile-image" src="/images/real-estate/kitchen.jpg" alt="A kitchen with a copper hood and brick backsplash, colour corrected" loading="lazy" width="1600" height="1069" />
        <h3>Back in 48 Hours</h3>
        <p>Photos and video come back in 48 hours. We can hold that because the editing happens on our team rather than in a queue at an offshore service, so three listings landing in the same week does not push everyone back a day.</p>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">A recent listing</span>
      <h2>One house, start to finish.</h2>
    </div>
    <div class="wedding-strip">
      <img src="/images/real-estate/aerial-house.jpg" alt="Aerial view of a stone home with a circular paver driveway" loading="lazy" width="1600" height="1069" />
      <img src="/images/real-estate/entry-staircase.jpg" alt="An entry hall with a curved staircase and iron front doors" loading="lazy" width="1600" height="1069" />
      <img src="/images/real-estate/kitchen-island.jpg" alt="A kitchen island with seating, brick walls and stainless appliances" loading="lazy" width="1600" height="1069" />
    </div>
    <div class="wedding-strip" style="margin-top: 1.5rem;">
      <img src="/images/real-estate/great-room.jpg" alt="A two storey great room seen from the landing above" loading="lazy" width="1600" height="1069" />
      <img src="/images/real-estate/pool.jpg" alt="A curved pool with a rock waterfall and loungers" loading="lazy" width="1600" height="1069" />
      <img src="/images/real-estate/pool-aerial.jpg" alt="Aerial of the pool and spa looking out to a golf fairway" loading="lazy" width="1600" height="1069" />
    </div>
    <p style="text-align: center; margin-top: 2rem; color: var(--muted);">Exteriors, aerials, every room, and the amenities that sell the house. One visit.</p>
  </div>
</section>

<section style="background: var(--soft);">
  <div class="container-narrow">
    <div class="section-head">
      <span class="eyebrow">What it costs</span>
      <h2>Per listing, not per hour.</h2>
    </div>
    <p>No packages to decode and no quote to wait for. Photos and video are priced the same, so shooting both is a straightforward decision rather than a negotiation.</p>
    <div style="margin-top: 2rem; border: 1px solid var(--border); border-radius: 12px; overflow: hidden;">
      <div style="display: flex; justify-content: space-between; gap: 1rem; padding: 1rem 1.25rem; border-bottom: 1px solid var(--border); background: rgba(255,255,255,0.03);">
        <span><strong>Photos</strong><br><span style="font-size: 0.85rem; color: var(--muted);">Full gallery, per listing</span></span>
        <span style="white-space: nowrap;"><strong>$200</strong></span>
      </div>
      <div style="display: flex; justify-content: space-between; gap: 1rem; padding: 1rem 1.25rem; border-bottom: 1px solid var(--border);">
        <span>Video<br><span style="font-size: 0.85rem; color: var(--muted);">Per listing</span></span>
        <span style="white-space: nowrap;">$200</span>
      </div>
      <div style="display: flex; justify-content: space-between; gap: 1rem; padding: 1rem 1.25rem; border-bottom: 1px solid var(--border);">
        <span>Drone, added to a shoot<br><span style="font-size: 0.85rem; color: var(--muted);">Booked alongside photos or video</span></span>
        <span style="white-space: nowrap;">$50</span>
      </div>
      <div style="display: flex; justify-content: space-between; gap: 1rem; padding: 1rem 1.25rem;">
        <span>Drone on its own</span><span style="white-space: nowrap;">$200</span>
      </div>
    </div>
    <p style="margin-top: 1.25rem;">Aerials are $50 when we are already at the house, which is the cheapest upgrade on this page and the reason most listings we shoot end up with one. Booking a lot of listings? Tell us how many a month and we will quote it properly.</p>
  </div>
</section>

<section>
  <div class="container-narrow">
    <div class="section-head">
      <span class="eyebrow">Why agents switch</span>
      <h2>The photos are usually not the problem. The wait is.</h2>
    </div>
    <p>Most agents do not leave their photographer over quality. They leave because the gallery took four days, the listing went up with three phone pictures, and the first weekend was wasted. A house gets one launch. Ours come back in 48 hours.</p>
    <p style="margin-top: 1.25rem;">We work with agents across Coldwell Banker Southern Realty's offices already, which means we are used to a brokerage's pace rather than a hobbyist's calendar. One photographer here shoots listings and nothing else, so your Tuesday is not competing with somebody's wedding on Saturday.</p>
    <div class="text-center" style="margin-top: 2.5rem;">
      <a href="#agent-signup" class="btn btn-primary">Set up your account</a>
    </div>
  </div>
</section>

{/* AGENT SIGNUP.
    Deliberately NOT framed as signing up for Slate. Agents get a client login
    inside SDub Media's own Slate workspace; they are not buying software for
    their brokerage, and any wording that implies otherwise creates exactly the
    confusion Geoff flagged. Never say "sign up for Slate" here.

    Posts to the same capture endpoint the contact form uses, with projectType
    "Listing shoot" so these are identifiable in the pipeline at a glance (that
    value was added to the allowlist in the Slate repo; anything unrecognised
    would silently collapse to "Other"). Access is granted by invite from
    Slate afterwards. There is deliberately no self-serve account creation:
    that is public signup into a multi-tenant app holding client data. */}
<section id="agent-signup" style="background: var(--soft);">
  <div class="container-narrow">
    <div class="section-head">
      <span class="eyebrow">For agents we shoot for</span>
      <h2>Book listings without texting anybody.</h2>
    </div>
    <p>Every agent we work with gets a login to our booking system. See when we are free, book a listing against a date, track where the shoot is, and pull your gallery when it is ready. It is included, it costs nothing, and it is how we keep a brokerage's worth of listings straight.</p>
    <p style="margin-top: 1.25rem; font-size: 0.9rem; color: var(--muted);">This is an account with us, not software for your brokerage to run. Tell us who you are and we will set it up.</p>

    <form id="agent-form" style="margin-top: 2rem; display: grid; gap: 1rem;">
      <div style="display: grid; gap: 1rem; grid-template-columns: 1fr 1fr;" class="agent-row">
        <input id="ag-name" name="name" type="text" placeholder="Your name" required autocomplete="name" />
        <input id="ag-email" name="email" type="email" placeholder="Email" required autocomplete="email" />
      </div>
      <div style="display: grid; gap: 1rem; grid-template-columns: 1fr 1fr;" class="agent-row">
        <input id="ag-phone" name="phone" type="tel" placeholder="Phone" autocomplete="tel" />
        <input id="ag-brokerage" name="brokerage" type="text" placeholder="Brokerage" />
      </div>
      <input id="ag-listings" name="listings" type="text" placeholder="Roughly how many listings a month?" />
      {/* honeypot: real people leave this empty */}
      <input id="ag-company" name="company" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;" />
      <button id="ag-submit" type="submit" class="btn btn-primary" style="justify-self: start;">Set up my account</button>
      <p id="ag-status" class="form-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>
</Layout>

<style>
  #agent-form input {
    width: 100%;
    padding: 0.8rem 1rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    font-family: inherit;
    font-size: 0.95rem;
  }
  #agent-form input:focus { outline: none; border-color: var(--brand); }
  #agent-form input::placeholder { color: var(--muted); }
  .form-status { font-size: 0.9rem; margin: 0; }
  .form-status.ok { color: #4ade80; }
  .form-status.err { color: #f87171; }
  @media (max-width: 640px) {
    .agent-row { grid-template-columns: 1fr !important; }
  }
</style>

<script>
  const form = document.getElementById('agent-form') as HTMLFormElement | null;
  if (form) {
    const btn = document.getElementById('ag-submit') as HTMLButtonElement;
    const status = document.getElementById('ag-status') as HTMLParagraphElement;
    const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim();
    const track = (n: string, p: Record<string, unknown> = {}) => {
      const w = window as unknown as { gtag?: (...a: unknown[]) => void };
      if (typeof w.gtag === 'function') w.gtag('event', n, p);
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const honey = val('ag-company');
      const name = val('ag-name'), email = val('ag-email');
      if (!name || !email) {
        status.textContent = 'Please add your name and email.';
        status.className = 'form-status err';
        return;
      }
      btn.disabled = true; btn.textContent = 'Sending...';

      // Everything the agent typed goes into the message so nothing is lost,
      // and the lead is tagged so it is obvious what follow-up it needs.
      const notes = [
        'Requested a booking account (real estate agent).',
        val('ag-brokerage') && `Brokerage: ${val('ag-brokerage')}`,
        val('ag-listings') && `Listings per month: ${val('ag-listings')}`,
      ].filter(Boolean).join('\n');

      const payload = {
        slug: 'sdub-media',
        name, email, phone: val('ag-phone'),
        projectType: 'Listing shoot',
        planning: 'Listing shoot',
        message: notes,
        company: honey,
      };
      const done = () => {
        form.style.display = 'none';
        status.textContent = "Thanks. We'll set your account up and email your login within one business day.";
        status.className = 'form-status ok';
        if (!honey) track('agent_signup', { brokerage: val('ag-brokerage') || 'not given' });
      };
      const fail = (m: string) => {
        status.textContent = m;
        status.className = 'form-status err';
        btn.disabled = false; btn.textContent = 'Set up my account';
        if (!honey) track('agent_signup_failed');
      };
      try {
        const r = await fetch('https://slate.sdubmedia.com/api/capture-pipeline-lead', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (r.ok) return done();
        throw new Error('slate non-ok');
      } catch {
        if (!honey) track('agent_signup_fallback_used');
        try {
          const r2 = await fetch('/api/contact', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (r2.ok) return done();
          fail('Something went wrong. Please email geoff@sdubmedia.com.');
        } catch {
          fail('Network error. Please email geoff@sdubmedia.com.');
        }
      }
    });
  }
</script>
