---
import Layout from '../layouts/Layout.astro';
import VideoGrid from '../components/VideoGrid.astro';

// ── HOW TO ADD A VIDEO ──────────────────────────────────────────────
// Fill in an item below. `vimeo` is the id from the URL:
//   https://vimeo.com/1192295930            →   vimeo: '1192295930'
//   https://vimeo.com/1192295930/ab12cd34   →   vimeo: '1192295930/ab12cd34'  (private/unlisted)
// Leave `vimeo` as '' to show a styled "Coming soon" placeholder tile.
// Only use REAL clients from the approved list. No invented names.
//
// THIS PAGE IS A BEST-OF, AND ITS JOB IS RANGE.
// One short piece per category, no client twice. The category pages
// (/business, /dance, /weddings) go deep; this page proves breadth.
// Rules that keep it working:
//   - Keep everything under ~90s. Nobody browses into a long film from a grid.
//     The 59-min recital and the 10-min Hawaii film stay on their own pages,
//     where their runtime is labelled and expected.
//   - Reusing a video that also appears on a category page is fine. What is
//     not fine is the same video twice on ONE page.
//   - Never ship a "Coming soon" tile here. An empty tile on a video
//     company's portfolio reads worse than a smaller grid.
//
// Held back on purpose: the second Elite Dance piece and the Nolensville
// season clip (dance is already represented), and the oncology patient
// welcome video (adds healthcare range but is the one piece we cannot
// currently attribute). Swap that in for the church tile if healthcare
// matters more than community work.
//
// GAP: there is no podcast video anywhere on the site, yet podcast production
// is one of three headline services on the homepage. The old "Coming soon"
// podcast tile was removed rather than advertise the hole.
// ────────────────────────────────────────────────────────────────────
const items = [
  // Leads deliberately: a recurring on-camera series for a named brokerage is
  // the core offering. Credits CBSR, not the individual agent.
  { title: 'Coldwell Banker Southern Realty', category: 'Agent on camera', vimeo: '1214149996' },
  { title: 'Tutoring Rocks', category: 'Brand video', vimeo: '707958942' },
  { title: 'Webb School Summer Camp', category: 'Education', vimeo: '1214150712' },
  { title: 'Nolensville Dance Company', category: 'Studio promo', vimeo: '1192295930' },
  { title: 'Wedding sizzle reel', category: 'Wedding · 38 sec', vimeo: '1150766730' },
  { title: 'Church at Nolensville', category: 'Community event', vimeo: '1214151209' },
  // Moved here from the dance page (Geoff, 2026-08-14): portfolio only.
  // Local thumb is the film's first frame (Geoff supplied it; the video is
  // unlisted on Vimeo so its thumbnail can't be fetched). Playback still
  // needs the privacy change (public, or embed restricted to sdubmedia.com
  // like the Aug wedding film).
  { title: 'Color War', category: 'Event recap · 90 sec', vimeo: '1218335236', thumb: '/images/events/color-war.jpg' },
];
---
<Layout title="Portfolio | SDub Media Nashville" description="Work from SDub Media: corporate video, recurring content, weddings, and events in Nashville.">
<section>
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Our work</span>
      <h1>Portfolio</h1>
      <p style="max-width: 560px; margin: 1rem auto 0;">One piece from each kind of work we do, for real clients around the Nashville area. More available on request, including full-length recital and wedding films.</p>
    </div>

    <div style="margin-top: 2rem;">
      <VideoGrid items={items} />
    </div>

    <p style="text-align: center; margin-top: 3rem; color: var(--muted);">
      Want to see more? <a href="/contact">Get in touch</a> and we'll send work that matches what you're planning.
    </p>
  </div>
</section>

{/* PHOTOGRAPHY. The video grid above is click-to-play, so stills must not sit
    inside it: a photo in that grid reads as a broken video. Separate section,
    and the same range rule applies as the videos above, one per category.
    Reusing frames that appear on a service page is fine here (this page is a
    best-of); what is not fine is the same image twice on this page. */}
<section style="background: var(--soft);">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Photography</span>
      <h2>We shoot stills as well.</h2>
    </div>
    <div class="wedding-strip">
      <img src="/images/real-estate/aerial-house.jpg" alt="Aerial view of a stone home with a circular paver driveway" loading="lazy" width="1600" height="1069" />
      <img src="/images/corporate/team-portrait.jpg" alt="A full brokerage team photographed together on steps outdoors" loading="lazy" width="1600" height="1067" />
      <img src="/images/events/gala-room.jpg" alt="A gala ballroom set for dinner, seen from the balcony" loading="lazy" width="1600" height="1069" />
      <img src="/images/corporate/office-group.jpg" alt="A brokerage team photographed together inside their office" loading="lazy" width="1600" height="1067" />
    </div>
    {/* Separate row: these are 2:3 full-body portraits and the wide strip above
        would crop them at the chest. */}
    <div class="photo-strip-tall" style="margin-top: 1.5rem;">
      <img src="/images/corporate/business-portrait.jpg" alt="Two colleagues photographed back to back on a tree lined path" loading="lazy" width="1600" height="2400" />
      <img src="/images/corporate/portrait-trio.jpg" alt="Three colleagues photographed together outdoors" loading="lazy" width="1100" height="1650" />
      <img src="/images/corporate/portrait-solo.jpg" alt="An individual business portrait, walking toward camera" loading="lazy" width="1100" height="1650" />
    </div>
    <p style="text-align: center; margin-top: 2rem; color: var(--muted);">Listings, corporate portraits and events. All of it, plus seniors and families, is on the <a href="/photography">photography page</a>.</p>
  </div>
</section>
</Layout>
