---
import Layout from '../layouts/Layout.astro';
import VideoGrid from '../components/VideoGrid.astro';

// ── HOW TO ADD A VIDEO ──────────────────────────────────────────────
// Fill in an item below. `vimeo` is the id from the URL:
//   https://vimeo.com/1192295930            →   vimeo: '1192295930'
//   https://vimeo.com/1192295930/ab12cd34   →   vimeo: '1192295930/ab12cd34'  (private/unlisted)
// Leave `vimeo` as '' to show a styled "Coming soon" placeholder tile.
// Only use REAL clients from the approved list. No invented names.
// (Step 3 makes this list editable from the site login.)
// ────────────────────────────────────────────────────────────────────
const items = [
  { title: 'Featured Reel', category: 'Recurring content', vimeo: '1192295930' },
  { title: 'Coming soon', category: 'Corporate', vimeo: '' },
  { title: 'Coming soon', category: 'Event', vimeo: '' },
  { title: 'Coming soon', category: 'Podcast', vimeo: '' },
  { title: 'Coming soon', category: 'Wedding', vimeo: '' },
  { title: 'Coming soon', category: 'Brand', vimeo: '' },
];
---
<Layout title="Portfolio | SDub Media Nashville" description="Work from SDub Media: corporate video, recurring content, weddings, and events in Nashville.">
<section>
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Our work</span>
      <h1>Portfolio</h1>
      <p style="max-width: 560px; margin: 1rem auto 0;">A selection of work from our Nashville clients. Full portfolio available on request.</p>
    </div>

    <div style="margin-top: 2rem;">
      <VideoGrid items={items} />
    </div>

    <p style="text-align: center; margin-top: 3rem; color: var(--muted);">
      Want to see more? <a href="/contact">Get in touch</a> and we'll send work that matches what you're planning.
    </p>
  </div>
</section>
</Layout>
