---
import Layout from '../layouts/Layout.astro';

// EVERY call to action on the site lands here, so this form has to recognise
// every service the site sells. It did not: a fresh review (2026-07-31) found
// the dropdown offered no option for listing shoots or dance work, which meant
// two of the five service pages funnelled their traffic into "Other". The
// options below must stay in sync with `KNOWN_PROJECT_TYPES` in Slate's
// api/capture-pipeline-lead.ts. An unrecognised value is silently coerced to
// "Other" there, so adding an option here WITHOUT adding it there looks like it
// works and quietly throws away the categorisation.
//
// The `value` is the canonical type Slate stores; the label is what visitors
// read. Keep them decoupled so wording can change without a Slate deploy.
---
<Layout title="Contact | SDub Media Nashville Video Production" description="Start a conversation with SDub Media. Tell us what you're planning and we'll reply within 24 hours.">
<section>
  <div class="container-narrow">
    <div class="text-center">
      <span class="eyebrow">Start a project</span>
      <h1>Tell us what you're planning.</h1>
      <p style="font-size: 1.1rem; max-width: 520px; margin: 1.5rem auto 2.5rem;">A weekly series, a conference, a listing, a recital, or a wedding day. Tell us a little about it and we'll reply within 24 hours.</p>
    </div>

    <form id="contact-form" class="contact-form" novalidate>
      <div class="field">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" required autocomplete="name">
      </div>
      <div class="field-row">
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email">
        </div>
        <div class="field">
          <label for="phone">Phone</label>
          <input id="phone" name="phone" type="tel" autocomplete="tel">
        </div>
      </div>
      <div class="field">
        <label for="planning">What are you planning?</label>
        <select id="planning" name="planning">
          <option value="">Select one</option>
          <option value="Recurring content">Recurring content for my business</option>
          <option value="Event coverage">Corporate or speaker event</option>
          <option value="Listing shoot">Real estate listing</option>
          <option value="Dance or recital">Dance studio or recital</option>
          <option value="Wedding">Wedding</option>
          <option value="Brand video">One-off brand video</option>
          <option value="Other">Something else</option>
        </select>
      </div>
      <!-- Shown only for the types that actually have a date. Hiding it by
           default is what takes the form from seven fields to five. -->
      <div class="field-row" id="date-fields" hidden>
        <div class="field">
          <label for="eventDate">Date <span class="opt">(if you have one)</span></label>
          <input id="eventDate" name="eventDate" type="date">
        </div>
        <div class="field">
          <label for="eventTime">Start time <span class="opt">(if you have one)</span></label>
          <input id="eventTime" name="eventTime" type="time" step="3600">
        </div>
      </div>
      <div class="field">
        <label for="message">Anything else? <span class="opt">(optional)</span></label>
        <textarea id="message" name="message" rows="4"></textarea>
      </div>

      <!-- Honeypot: hidden from people, bots fill it. -->
      <div class="hp" aria-hidden="true">
        <label for="company">Company</label>
        <input id="company" name="company" type="text" tabindex="-1" autocomplete="off">
      </div>

      <button type="submit" class="btn btn-primary" id="submit-btn">Send it over</button>
      <p id="form-status" class="form-status" role="status"></p>
    </form>

    <p class="fallback">Prefer to talk? Call <a href="tel:+16157079143">615-707-9143</a>, or email <a href="mailto:geoff@sdubmedia.com">geoff@sdubmedia.com</a>.</p>

    <!-- The real estate page promises agents an account they can book listings
         from without texting anybody. That promise died here before: this page
         never mentioned it, so the thread just dropped at the moment of
         conversion. -->
    <p class="fallback" style="margin-top: 0.75rem;">Booking listings regularly? Agents get an account to book from directly. Ask for it on the <a href="/real-estate-photography">real estate page</a>.</p>
  </div>
</section>

<style>
  .contact-form { max-width: 560px; margin: 0 auto; text-align: left; }
  .field { margin-bottom: 1.25rem; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .field label { display: block; font-size: 0.85rem; font-weight: 600; color: var(--text-dim); margin-bottom: 0.4rem; }
  .field label .opt { font-weight: 400; color: var(--muted); }
  .field input, .field select, .field textarea {
    width: 100%; padding: 0.7rem 0.9rem; font-size: 1rem; font-family: inherit;
    color: var(--text); background: var(--card); border: 1px solid var(--border-strong);
    border-radius: 8px; box-sizing: border-box;
  }
  .field input:focus, .field select:focus, .field textarea:focus {
    outline: none; border-color: var(--brand); background: var(--bg-elevated);
  }
  .field textarea { resize: vertical; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  #submit-btn { width: 100%; margin-top: 0.5rem; cursor: pointer; font-size: 1rem; }
  #submit-btn:disabled { opacity: 0.6; cursor: default; }
  .form-status { margin-top: 1rem; text-align: center; font-size: 0.95rem; min-height: 1.2rem; }
  .form-status.ok { color: var(--brand); }
  .form-status.err { color: #ff8a8a; }
  .fallback { text-align: center; color: var(--muted); font-size: 0.85rem; margin-top: 2rem; }
  @media (max-width: 540px) { .field-row { grid-template-columns: 1fr; } }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const btn = document.getElementById('submit-btn') as HTMLButtonElement;
  const status = document.getElementById('form-status') as HTMLParagraphElement;
  const eventDate = document.getElementById('eventDate') as HTMLInputElement;
  const eventTime = document.getElementById('eventTime') as HTMLInputElement;
  const planningSel = document.getElementById('planning') as HTMLSelectElement;
  const dateFields = document.getElementById('date-fields') as HTMLDivElement;

  // Only these have a date worth asking for. Recurring content and listing
  // shoots are scheduled in the follow-up conversation, so asking up front adds
  // two empty boxes to the form and nothing to the lead.
  const DATED_TYPES = new Set(['Event coverage', 'Dance or recital', 'Wedding']);
  const syncDateFields = () => {
    const show = DATED_TYPES.has(planningSel.value);
    dateFields.hidden = !show;
    // Clear on hide, or a visitor who picks a wedding date and then switches to
    // recurring content silently sends a date for a project that has none.
    if (!show) { eventDate.value = ''; eventTime.value = ''; }
  };
  planningSel.addEventListener('change', syncDateFields);
  syncDateFields();

  // Keep the optional event time on the hour: snap whatever the visitor picks to
  // the top of the hour. Fields stay empty until engaged, so leads without an
  // event don't carry a stray date or time.
  eventTime.addEventListener('change', () => {
    if (!eventTime.value) return;
    eventTime.value = eventTime.value.replace(/^(\d{2}):\d{2}/, '$1:00');
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.textContent = '';
    status.className = 'form-status';

    const fd = new FormData(form);
    const get = (k: string) => (fd.get(k) || '').toString();
    const planning = get('planning');
    // Recombine the separate date/time boxes into the single value the pipeline
    // expects. Time alone (no date) is meaningless, so it's dropped.
    const d = get('eventDate');
    const t = get('eventTime');
    const eventDateTime = d ? (t ? `${d}T${t}` : d) : '';
    const data = {
      slug: 'sdub-media', // routes the lead into the SDub Media Slate pipeline
      name: get('name').trim(),
      email: get('email').trim(),
      phone: get('phone').trim(),
      projectType: planning,
      planning, // kept for the email-only fallback below
      eventDateTime,
      message: get('message').trim(),
      company: get('company'), // honeypot
    };

    if (!data.name || !data.email) {
      status.textContent = 'Please add your name and email.';
      status.className = 'form-status err';
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Sending...';

    // Analytics. Submitting this form is the single conversion the whole site
    // exists for, and it was invisible to GA: the form posts in the background,
    // so there is no page navigation for automatic tracking to notice.
    const track = (name: string, params: Record<string, unknown> = {}) => {
      const w = window as unknown as { gtag?: (...a: unknown[]) => void };
      if (typeof w.gtag === 'function') w.gtag('event', name, params);
    };
    // Bots that fill the honeypot still get a 200 back (both endpoints silently
    // accept and drop them), so without this check every bot would count as a
    // conversion and quietly wreck the numbers.
    const isBot = !!data.company;

    // Primary: drop the lead straight into the Slate pipeline (also emails Geoff).
    // Fallback: if Slate is unreachable, the owned /api/contact email still fires
    // so no inquiry is ever lost.
    const SLATE_ENDPOINT = 'https://slate.sdubmedia.com/api/capture-pipeline-lead';
    const succeed = (route: 'slate' | 'email_fallback') => {
      form.style.display = 'none';
      status.textContent = "Thanks! We got it and we'll reply within 24 hours.";
      status.className = 'form-status ok';
      if (isBot) return;
      // Mark generate_lead as a key event in GA to treat it as a conversion.
      track('generate_lead', { project_type: data.projectType || 'not specified', route });
    };
    const reset = (msg: string) => {
      status.textContent = msg;
      status.className = 'form-status err';
      btn.disabled = false;
      btn.textContent = 'Send it over';
      // A real person tried to reach us and could not. Worth knowing about.
      if (!isBot) track('lead_submit_failed', { reason: msg.slice(0, 100) });
    };

    try {
      const res = await fetch(SLATE_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (res.ok) return succeed('slate');
      throw new Error('slate non-ok');
    } catch {
      // Fallback to the email-only function on this site. Reaching here means
      // Slate's capture endpoint is failing, which is invisible to the visitor
      // and would otherwise be invisible to us too.
      if (!isBot) track('lead_fallback_used');
      try {
        const res2 = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (res2.ok) return succeed('email_fallback');
        const j = await res2.json().catch(() => ({}));
        reset(j.error || 'Something went wrong. Please email geoff@sdubmedia.com.');
      } catch {
        reset('Network error. Please email geoff@sdubmedia.com.');
      }
    }
  });
</script>
</Layout>
