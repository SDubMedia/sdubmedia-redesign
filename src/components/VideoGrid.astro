---
// A lightweight, click-to-play grid of Vimeo videos. Used on Portfolio (6-up),
// Business (3-up), and Weddings (3-up). Nothing loads from Vimeo until a
// visitor clicks a card, so the page stays fast. Real thumbnails are pulled at
// build time from Vimeo's public oEmbed (no API key); a "Coming soon" tile
// shows for any item with an empty `vimeo`.
//
// (Step 3 makes these lists editable from the site login.)
export interface VideoItem {
  title?: string;
  client?: string;   // real client name, or omit
  category?: string; // e.g. 'Corporate', 'Wedding', 'Podcast'
  vimeo: string;     // Vimeo id, or 'id/hash' for private, or '' for a placeholder
  thumb?: string;    // local /images/... path; overrides the Vimeo-fetched thumbnail
}
interface Props {
  items?: VideoItem[];
  // Center the row instead of stretching it. Use when there are fewer items
  // than the grid has columns, so 2 cards don't read as "3 with one missing".
  center?: boolean;
}
const { items = [], center = false } = Astro.props;
import { vimeoVideoLd } from '../lib/vimeo-ld.mjs';

async function vimeoThumb(spec: string): Promise<string> {
  const m = spec.match(/(\d+)(?:\/([0-9a-zA-Z]+))?/);
  if (!m) return '';
  const link = m[2] ? `https://vimeo.com/${m[1]}/${m[2]}` : `https://vimeo.com/${m[1]}`;
  try {
    // referrer= is required for videos whose embed privacy is restricted to
    // sdubmedia.com: oEmbed 404s for them without it, and the card loses its
    // thumbnail. Harmless for fully public videos.
    const res = await fetch(`https://vimeo.com/api/oembed.json?width=1280&url=${encodeURIComponent(link)}&referrer=${encodeURIComponent('https://sdubmedia.com')}`);
    if (!res.ok) return '';
    const data = await res.json();
    return typeof data.thumbnail_url === 'string' ? data.thumbnail_url : '';
  } catch { return ''; }
}

const cards = await Promise.all(items.map(async (item) => {
  const m = String(item.vimeo ?? '').match(/(\d+)(?:\/([0-9a-zA-Z]+))?/);
  return {
    title: item.title ?? '',
    client: item.client ?? '',
    category: item.category ?? '',
    id: m?.[1] ?? '',
    hash: m?.[2] ?? '',
    thumb: item.thumb ?? (item.vimeo ? await vimeoThumb(item.vimeo) : ''),
    // Structured data per real video; placeholders get none.
    ld: item.vimeo ? await vimeoVideoLd(item.vimeo, item.title ?? '') : null,
  };
}));
const gridLd = cards.map(c => c.ld).filter(Boolean);
---
{gridLd.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(gridLd)} />}
<div class:list={["pf-grid", center && "pf-grid--center"]}>
  {cards.map(card => (
    card.id ? (
      <button class="pf-card" data-vimeo={card.id} data-hash={card.hash} aria-label={`Play ${card.title}`}>
        <span
          class:list={["pf-thumb", !card.thumb && "pf-thumb-empty"]}
          style={card.thumb ? `background-image: url(${card.thumb})` : ''}
        >
          <span class="pf-play" aria-hidden="true">▶</span>
        </span>
        <span class="pf-meta">
          {card.category && <span class="pf-cat">{card.category}</span>}
          {card.title && <span class="pf-title">{card.title}</span>}
          {card.client && <span class="pf-client">{card.client}</span>}
        </span>
      </button>
    ) : (
      <div class="pf-card pf-empty">
        <span class="pf-thumb pf-thumb-empty"><span class="pf-soon">Coming soon</span></span>
        <span class="pf-meta">
          {card.category && <span class="pf-cat">{card.category}</span>}
        </span>
      </div>
    )
  ))}
</div>

<style>
  .pf-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }
  /* Few-item variant: cap the card width and center the row so a 2-up doesn't
     sit left-aligned against an empty third column. Columns still collapse to
     one below ~340px of available width, so no horizontal overflow. */
  .pf-grid--center {
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 400px));
    justify-content: center;
  }
  .pf-card {
    display: block;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    text-align: left;
    padding: 0;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    color: var(--text);
    font: inherit;
    cursor: pointer;
    transition: border-color 0.15s;
  }
  .pf-card:hover { border-color: var(--brand); }
  .pf-empty { cursor: default; }

  .pf-thumb {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background-size: cover;
    background-position: center;
    background-color: var(--bg-elevated);
  }
  .pf-thumb-empty { display: flex; align-items: center; justify-content: center; }
  .pf-soon { color: var(--muted); font-size: 0.8rem; letter-spacing: 0.05em; text-transform: uppercase; }

  .pf-play {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 56px; height: 56px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(12, 18, 32, 0.7);
    border: 1px solid var(--brand);
    border-radius: 50%;
    color: var(--brand);
    font-size: 1.1rem;
    padding-left: 4px;
    transition: background 0.15s, transform 0.15s;
  }
  .pf-card:hover .pf-play { background: var(--brand); color: #0c1220; transform: translate(-50%, -50%) scale(1.06); }

  .pf-meta { display: block; padding: 1rem 1.25rem 1.25rem; }
  .pf-cat { display: block; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--brand); margin-bottom: 0.35rem; }
  .pf-title { display: block; font-weight: 600; letter-spacing: -0.01em; }
  .pf-client { display: block; font-size: 0.85rem; color: var(--muted); margin-top: 0.15rem; }

</style>

{/* Everything below is created by the click handler at runtime, so it CANNOT
    use the scoped block above: Astro scopes styles to build-time elements, and
    JS-created nodes never match them. That exact mismatch once shipped as a
    bug where the lightbox rendered unstyled at the bottom-left of the page.
    Runtime-created classes (.pf-lb*, .pf-card--playing, .pf-inline, .pf-expand)
    stay in this is:global block. */}
<style is:global>
  /* Inline playback: the card's thumbnail is swapped for the player in place. */
  .pf-card--playing {
    display: block;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    text-align: left;
    background: var(--card);
    border: 1px solid var(--brand);
    border-radius: 12px;
    overflow: hidden;
    color: var(--text);
  }
  .pf-inline { position: relative; aspect-ratio: 16 / 9; background: #000; }
  .pf-inline iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .pf-expand {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 2;
    width: 2.25rem;
    height: 2.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    line-height: 1;
    color: var(--text);
    background: rgba(8, 12, 20, 0.65);
    border: 1px solid var(--border);
    border-radius: 8px;
    cursor: pointer;
  }
  .pf-expand:hover { background: rgba(8, 12, 20, 0.9); border-color: var(--brand); }

  /* Expanded player: a centered, size-capped overlay. Deliberately NOT full
     screen on desktop; Vimeo's own fullscreen button covers that case. */
  .pf-lb {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    background: rgba(8, 12, 20, 0.88);
    backdrop-filter: blur(3px);
  }
  .pf-lb[hidden] { display: none; }
  .pf-lb-frame {
    position: relative;
    width: min(960px, 92vw);
    /* Cap the width so the derived 16:9 height never exceeds the viewport. */
    max-width: calc((100vh - 8rem) * 16 / 9);
    aspect-ratio: 16 / 9;
    background: #000;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }
  .pf-lb-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .pf-lb-close {
    position: absolute;
    top: -2.75rem;
    right: 0;
    width: 2.25rem;
    height: 2.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    line-height: 1;
    color: var(--text);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border);
    border-radius: 50%;
    cursor: pointer;
  }
  .pf-lb-close:hover { background: rgba(255, 255, 255, 0.16); }
  /* On short screens the button would sit off-screen above the frame. */
  @media (max-height: 520px) {
    .pf-lb-close { top: 0.35rem; right: 0.35rem; }
  }
</style>

<script>
  // Click-to-play facade: nothing loads from Vimeo until a card is clicked.
  // A click swaps the card's thumbnail for the player IN PLACE; the ⤢ button
  // on the playing card opens the same video in a centered, size-capped
  // overlay (not full screen; Vimeo's own fullscreen control covers that).
  // Only one card plays at a time. Runtime-created nodes must use classes
  // from the is:global style block, never the scoped one.
  (() => {
    let overlay: HTMLDivElement | null = null;
    let frame: HTMLDivElement | null = null;
    let lastFocused: HTMLElement | null = null;
    let active: { original: HTMLElement; playing: HTMLElement } | null = null;

    function makeIframe(id: string, hash: string | null, label: string) {
      const iframe = document.createElement('iframe');
      iframe.src = `https://player.vimeo.com/video/${id}?autoplay=1&title=0&byline=0&portrait=0&dnt=1${hash ? `&h=${hash}` : ''}`;
      iframe.allow = 'autoplay; fullscreen; picture-in-picture; clipboard-write';
      iframe.setAttribute('allowfullscreen', '');
      iframe.title = label || 'Video';
      return iframe;
    }

    // Put the original thumbnail card back (also stops inline playback).
    function restoreCard() {
      if (!active) return;
      active.playing.replaceWith(active.original);
      active = null;
    }

    function playInline(card: HTMLElement, id: string, hash: string | null, label: string) {
      restoreCard();
      const playing = document.createElement('div');
      playing.className = 'pf-card--playing';

      const box = document.createElement('div');
      box.className = 'pf-inline';
      box.appendChild(makeIframe(id, hash, label));

      const expand = document.createElement('button');
      expand.className = 'pf-expand';
      expand.type = 'button';
      expand.setAttribute('aria-label', `Open ${label || 'video'} in a larger player`);
      expand.textContent = '⤢';
      expand.addEventListener('click', () => {
        restoreCard();
        openOverlay(id, hash, label);
      });
      box.appendChild(expand);
      playing.appendChild(box);

      // The meta block keeps its build-time scoping attributes when cloned,
      // so the scoped styles still apply to it.
      const meta = card.querySelector('.pf-meta');
      if (meta) playing.appendChild(meta.cloneNode(true));

      card.replaceWith(playing);
      active = { original: card, playing };
    }

    function closeOverlay() {
      if (!overlay) return;
      overlay.hidden = true;
      if (frame) frame.querySelector('iframe')?.remove(); // stops playback
      document.body.style.overflow = '';
      lastFocused?.focus();
    }

    function buildOverlay() {
      overlay = document.createElement('div');
      overlay.className = 'pf-lb';
      overlay.hidden = true;
      overlay.setAttribute('role', 'dialog');
      overlay.setAttribute('aria-modal', 'true');
      overlay.setAttribute('aria-label', 'Video player');

      frame = document.createElement('div');
      frame.className = 'pf-lb-frame';

      const btn = document.createElement('button');
      btn.className = 'pf-lb-close';
      btn.type = 'button';
      btn.setAttribute('aria-label', 'Close video');
      btn.innerHTML = '&times;';
      btn.addEventListener('click', closeOverlay);

      frame.appendChild(btn);
      overlay.appendChild(frame);
      // Click the backdrop (not the video) to close.
      overlay.addEventListener('click', e => { if (e.target === overlay) closeOverlay(); });
      document.body.appendChild(overlay);
    }

    function openOverlay(id: string, hash: string | null, label: string) {
      if (!overlay) buildOverlay();
      if (!overlay || !frame) return;
      lastFocused = document.activeElement as HTMLElement;
      frame.querySelector('iframe')?.remove();
      frame.appendChild(makeIframe(id, hash, label));
      overlay.hidden = false;
      document.body.style.overflow = 'hidden';
      frame.querySelector<HTMLButtonElement>('.pf-lb-close')?.focus();
    }

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') {
        if (overlay && !overlay.hidden) closeOverlay();
        else restoreCard();
      }
    });

    document.querySelectorAll<HTMLElement>('.pf-card[data-vimeo]').forEach(card => {
      card.addEventListener('click', () => {
        const id = card.getAttribute('data-vimeo');
        if (!id) return;
        playInline(card, id, card.getAttribute('data-hash'), card.getAttribute('aria-label') || '');
      });
    });
  })();
</script>
