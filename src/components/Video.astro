---
// Reusable video player. Pass a Vimeo video id (the number in the URL) or a
// full Vimeo link — both work. Ids present in src/data/videos.json render the
// native <video> player from our R2 copy (no third-party JS, file on our
// domain); ids not uploaded yet fall back to the Vimeo embed, so the
// migration never breaks a page. Clean, responsive 16:9 either way.
//
// Usage: <Video id="123456789" title="Coldwell Banker brand film" />
const { id, title = "Video" } = Astro.props;

// Accept a raw id, a full link, or a private/unlisted link with a hash
// (vimeo.com/123456789/abcdef123). Pull out the id and the optional hash.
const raw = String(id ?? "").trim();
const m = raw.match(/(\d+)(?:\/([0-9a-zA-Z]+))?/);
const vimeoId = m?.[1] ?? "";
const hash = m?.[2] ? `&h=${m[2]}` : "";
const src = vimeoId
  ? `https://player.vimeo.com/video/${vimeoId}?title=0&byline=0&portrait=0&dnt=1${hash}`
  : "";

import { selfHosted, selfHostedLd } from '../lib/video-manifest.mjs';
const hosted = vimeoId ? selfHosted(raw) : null;

// VideoObject structured data so the work can surface as a video result.
// Self-hosted videos build it from the manifest (no network, our URLs);
// Vimeo fallbacks use the same public oEmbed VideoGrid uses; null (no
// block emitted) whenever Vimeo doesn't answer.
import { vimeoVideoLd } from '../lib/vimeo-ld.mjs';
const videoLd = hosted
  ? selfHostedLd(hosted, title)
  : vimeoId ? await vimeoVideoLd(raw, title) : null;
---
{videoLd && <script type="application/ld+json" set:html={JSON.stringify(videoLd)} />}

{hosted ? (
  <div class="video-embed">
    <video controls playsinline preload="metadata" poster={hosted.poster} title={title}>
      <source src={hosted.src} type="video/mp4" />
    </video>
  </div>
) : vimeoId ? (
  <div class="video-embed">
    <iframe
      src={src}
      title={title}
      loading="lazy"
      frameborder="0"
      allow="autoplay; fullscreen; picture-in-picture; clipboard-write"
      allowfullscreen
    ></iframe>
  </div>
) : (
  <div class="video-embed video-embed--empty">No video set</div>
)}

<style>
  .video-embed {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 14px;
    overflow: hidden;
    background: var(--bg-elevated, #151d2e);
    border: 1px solid var(--border, #2a3547);
  }
  .video-embed iframe,
  .video-embed video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video-embed video { object-fit: contain; background: #000; }
  .video-embed--empty {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted, #7d8ba3);
    font-size: 0.85rem;
  }
</style>
